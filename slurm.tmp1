#!/bin/bash
#SBATCH --job-name=<%= job.name %>
#SBATCH --output=<%= log.file %>
#SBATCH --error=<%= log.file %>
#SBATCH --time=<%= resources$walltime %>
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=<%= resources$ncpus %>
#SBATCH --mem-per-cpu=<%= resources$memory %>
#SBATCH --partition=<%= resources$partition %>
<%= if (array.jobs) sprintf("#SBATCH --array=1-%i", nrow(jobs)) else "" %>

## --- environment ---
module load R/4.5.0     # adjust to your cluster
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
# Shared renv cache on scratch keeps array tasks from re-installing packages:
export RENV_PATHS_CACHE="${SCRATCH:-$HOME}/renv-cache"

cd <%= getwd() %>

## --- run one batchtools job collection (= one array task) ---
Rscript -e 'batchtools::doJobCollection("<%= uri %>")'